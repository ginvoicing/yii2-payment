{
    "name": "ginvoicing/yii2-payment",
    "description": "Yii2 extension to verify payments with different payment gateway providers and log them in database.",
    "keywords": [
        "yii2",
        "payment",
        "gateway",
        "razorpay",
        "api"
    ],
    "type": "yii2-extension",
    "license": "MIT",
    "minimum-stability": "stable",
    "support": {
        "issues": "https://github.com/ginvoicing/yii2-payment/issues",
        "source": "https://github.com/ginvoicing/yii2-payment"
    },
    "authors": [
        {
            "name": "Tarun Jangra",
            "email": "tarun.jangra@hotmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-curl": "*",
        "yiisoft/yii2": "^2.0.54",
        "razorpay/razorpay": "^2.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "codeception/codeception": "^5.3",
        "codeception/lib-innerbrowser": "^4.0",
        "codeception/module-asserts": "^3.2",
        "codeception/module-yii2": "^2.0.5",
        "codeception/assert-throws": "^1.5",
        "phpro/grumphp": "^2.0",
        "yiisoft/yii2-coding-standards": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "yii\\payment\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "data\\": "tests/_data/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "phpro/grumphp": true
        },
        "classmap-authoritative": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "scripts": {
        "post-install-cmd": [
            "([ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/phpcs --config-set installed_paths ../../yiisoft/yii2-coding-standards/)"
        ],
        "post-update-cmd": [
            "([ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/phpcs --config-set installed_paths ../../yiisoft/yii2-coding-standards/)"
        ]
    }
}
